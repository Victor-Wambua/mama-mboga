# Copy to .env (composer setup does this for you).
APP_ENV=local
APP_DEBUG=0
# Secret used to sign statement and order links. `composer setup` generates one.
# In production it must be a random string of 32+ characters.
APP_KEY=change-me-run-composer-setup
# Public address, used in links sent by WhatsApp. Leave blank to use the request's host.
APP_URL=
APP_TIMEZONE=Africa/Nairobi
# SQLite file, relative to the project root.
DB_PATH=var/mama-mboga.sqlite
# Set to 1 only if a trusted reverse proxy sets X-Forwarded-Proto.
TRUST_PROXY=0
