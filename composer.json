{
    "name": "victor-wambua/mama-mboga",
    "description": "Daily-price ordering for neighbourhood greengrocers: price board, WhatsApp order bridge, market shopping list and deni (credit) ledger. Framework-free PHP 8.",
    "type": "project",
    "license": "MIT",
    "authors": [{ "name": "Victor Wambua" }],
    "require": {
        "php": ">=8.3",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "ext-pdo_sqlite": "*"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.64",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": { "MamaMboga\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "MamaMboga\\Tests\\": "tests/" }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "process-timeout": 0,
        "platform": {
            "php": "8.3.0"
        }
    },
    "scripts": {
        "setup": "@php bin/console setup",
        "migrate": "@php bin/console migrate",
        "seed": "@php bin/console seed",
        "serve": "@php -S 127.0.0.1:8080 -t public public/index.php",
        "test": "phpunit",
        "stan": "phpstan analyse --memory-limit=1G",
        "cs": "php-cs-fixer fix --dry-run --diff",
        "cs:fix": "php-cs-fixer fix",
        "accuracy": "@php bin/console parser:accuracy",
        "check": ["@cs", "@stan", "@test"]
    },
    "scripts-descriptions": {
        "setup": "Create .env, generate an app key, run migrations",
        "seed": "Load the fictional Mama Njeri Greens demo shop",
        "serve": "Start the PHP built-in server on http://127.0.0.1:8080",
        "accuracy": "Print WhatsApp parser accuracy on the case table"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
